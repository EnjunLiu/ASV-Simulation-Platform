                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.00605, 0.0075, 0.00913)
                float inputs:ior = 1.5
                float inputs:metallic = 0.08
                float inputs:opacity = 1
                float inputs:roughness = 0.58
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "Camera"
    {
        custom string userProperties:blender:object_name = "Camera"
        float3 xformOp:rotateXYZ = (129.79974, -0.000086799024, -138.82698)
        float3 xformOp:scale = (0.99999994, 1, 1)
        double3 xformOp:translate = (-0.7928351163864136, 1.129135251045227, -1.3297955989837646)
