                color3f inputs:diffuseColor = (0.7, 0.7, 0.72)
                float inputs:ior = 1.5
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.25
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Battery_Matte_Black" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </ASV/_materials/Battery_Matte_Black/Principled_PBR.outputs:surface>
            custom string userProperties:blender:data_name = "Battery_Matte_Black"

            def Shader "Principled_PBR"
