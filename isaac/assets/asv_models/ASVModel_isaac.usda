            def Shader "Principled_PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.04
                float inputs:clearcoatRoughness = 0.28
                color3f inputs:diffuseColor = (0.86, 0.875, 0.88)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </ASV/_materials/Hatch_Diamond/Hatch_Nrm_Tex.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.52
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Hatch_Nrm_Tex" (
                prepend apiSchemas = ["ColorSpaceAPI"]
            )
            {
                uniform token colorSpace:name = "data"
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/HatchDiamond_Nrm.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </ASV/_materials/Hatch_Diamond/映射_001.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "映射_001"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </ASV/_materials/Hatch_Diamond/uvmap.outputs:result>
                float inputs:rotation = 0
                float2 inputs:scale = (26, 26)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

